# Documentation only: this project does not automatically load .env files.
# Export variables in your shell or your credential manager. Never commit real keys.
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
# Example standard per-million-token rates. Verify prices for your provider/model.
LLM_INPUT_USD_PER_MILLION=0.40
LLM_OUTPUT_USD_PER_MILLION=1.60
LLM_BUDGET_USD=1
# For an explicitly selected OpenAI-compatible provider:
LLM_BASE_URL=
LLM_API_KEY=
